# Dependencies
frontend/node_modules
backend/__pycache__
backend/*.pyc
backend/*.pyo

# Python caches, test caches, and local virtualenvs (never ship in the context;
# a locked .pytest_cache once broke the whole build with "Access is denied")
**/__pycache__
**/.pytest_cache
.venv*
**/.venv*

# Build outputs
frontend/build

# Database
backend/*.db

# IDE
.vscode
.idea
*.swp
*.swo

# Git
.git
.gitignore

# Logs
*.log
/var/log

# Test reports
test_reports/

# Environment files (will be set via docker env)
# .env files should be handled carefully in production

# Documentation
*.md
!requirements.md

# OS files
.DS_Store
Thumbs.db
